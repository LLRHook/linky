{
  "name": "linky",
  "version": "1.0.0",
  "description": "Linky fixes Discord social link previews and translates non-English tweets.",
  "main": "dist/index.js",
  "author": "Victor Ivanov <victor.n.ivanov@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LLRHook/linky.git"
  },
  "homepage": "https://github.com/LLRHook/linky#readme",
  "bugs": {
    "url": "https://github.com/LLRHook/linky/issues"
  },
  "keywords": [
    "discord",
    "discord-bot",
    "discord-js",
    "typescript",
    "link-fixer",
    "embeds",
    "translation"
  ],
  "scripts": {
