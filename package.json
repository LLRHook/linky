{
  "name": "linky",
  "version": "1.0.0",
  "description": "Linky fixes Discord social previews, preserves playable media and translates tweet text and Instagram captions.",
  "main": "dist/index.js",
  "author": "Victor Ivanov <victor.n.ivanov@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LLRHook/linky.git"
  },
  "homepage": "https://github.com/LLRHook/linky#readme",
  "bugs": {
    "url": "https://github.com/LLRHook/linky/issues"
  },
  "keywords": [
    "discord",
    "discord-bot",
    "discord-js",
    "typescript",
    "link-fixer",
    "embeds",
    "translation"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "check:workers": "tsc --project tsconfig.worker.json",
    "report:deliveries": "node ops/delivery-archive-report.mjs",
    "check:providers": "node ops/provider-metadata-check.mjs",
    "test": "tsc --project tsconfig.test.json && tsx --test tests/*.test.ts && node --test tests/*.test.mjs",
    "start": "node dist/index.js",
    "register-commands": "tsx src/commands/register.ts"
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.1",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.0",
    "esbuild": "^0.28.2",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
