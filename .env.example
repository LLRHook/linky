DISCORD_TOKEN=your_bot_token_here

# Exact channel IDs across any servers.
# Enable Message Content Intent and grant the channel permissions in README.
LINK_CHANNEL_IDS=

# Entire server IDs, covering all accessible current and future channels/threads.
# New servers stay inactive until an admin runs /setup enabled:True.
# These optional lists set the initial scope; saved /setup choices take priority.
LINK_SERVER_IDS=

# Persist /setup enablement and /settings preferences; Docker uses its data volume.
LINK_SETTINGS_PATH=data/servers.json

# Optional subset of x,instagram,tiktok,youtube,bluesky,reddit,twitch.
# Empty enables available platforms.
# YouTube is unavailable without YOUTUBE_API_KEY. Server preferences cannot
# re-enable an operator-disabled platform or change the configured channel scope.
REWRITE_PLATFORMS=

# English tweet text with a small source-language label; default off.
# Server admins may disable it through /settings, but cannot override this limit.
TRANSLATE_TWEETS=false

# Optional English Instagram captions, independent of tweet translation.
# Requires a separate Cloud Translation Basic v2 key and linked Google billing.
# Restrict the key to Cloud Translation and the host's outbound IP. Set a Cloud
# daily character quota of 15,000 before enabling; see README for pricing/limits.
# Keep data/translation-usage.json across restarts; it contains only date + usage.
# Server admins can turn this off with /settings translate_instagram:false.
TRANSLATE_INSTAGRAM=false
GOOGLE_TRANSLATE_API_KEY=

# Optional central operator key; hosted-bot server owners do not supply one.
# Enable YouTube Data API v3, restrict the key to that API and the host's outbound
# IP address. Missing key leaves YouTube links untouched. Never commit a real key.
# YouTube controls and legacy details cleanup use data/youtube-stats.json.
# Retain the data volume so cleanup continues after a restart.
YOUTUBE_API_KEY=
