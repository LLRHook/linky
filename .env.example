DISCORD_TOKEN=your_bot_token_here

# Optional: comma-separated exact channel IDs, including channels in different servers.
# Enable Message Content Intent in the Discord developer portal before setting these.
# See README for channel permissions. Empty list entries (including trailing commas) are invalid.
FIXUPX_CHANNEL_IDS=
# Legacy single-channel setting is still supported and combined with the list above.
# Leave both settings empty to disable X link replacement.
FIXUPX_CHANNEL_ID=
