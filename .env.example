DISCORD_TOKEN=your_bot_token_here

# Exact channel IDs across any servers; empty disables link replacement.
# Enable Message Content Intent and grant the channel permissions in README.
LINK_CHANNEL_IDS=

# Optional subset of x,instagram,tiktok; empty enables all three.
REWRITE_PLATFORMS=

# English tweet text with a small source-language label; default off.
TRANSLATE_TWEETS=false
